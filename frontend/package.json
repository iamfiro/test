{
  "name": "studyvillage-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "dev:mock": "VITE_DATA_SOURCE=mock vite --port 5190 --strictPort",
    "build": "npm run api:types && tsc --noEmit && vite build && node scripts/security-headers.mjs",
    "typecheck": "npm run api:types && tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript ../server/docs/api/openapi.yaml -o src/core/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/gaegu": "5.3.0",
    "@tabler/icons-react": "^3.52.0",
    "openapi-fetch": "^0.17.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
