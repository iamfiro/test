# 서버 환경 변수 예시. 실제 값은 .env(git 제외)나 호스트 비밀 저장소에 둔다.
NODE_ENV=development
PORT=5191
DATABASE_URL=postgres://studyvillage:studyvillage@localhost:55432/studyvillage
WEB_ORIGIN=http://localhost:5190
# 개발 전용 로그인. NODE_ENV=production에서 true면 서버가 시작을 거부한다.
DEV_LOGIN_ENABLED=true
LOG_LEVEL=info
# 같은 내용(닉네임·메시지)에 대한 서로 다른 사람의 신고가 이 수에 닿으면 바로 처리한다. 기본 3.
# REPORT_HIDE_THRESHOLD=3
# 긴급 스위치(app_settings) 캐시 시간(ms). CLI로 바꾼 값이 이 시간 안에 적용된다. 기본 5000.
# SETTINGS_CACHE_MS=5000
# 방 비밀번호 암호화 키(필수, 32바이트 base64). 개발용은 `openssl rand -base64 32`로 새로 만든다. 운영 키는 비밀 저장소에만.
ROOM_PASSWORD_KEY=
# 초대 링크 `https://<웹>/r#<token>`의 웹 주소. WEB_ORIGIN이 하나면 생략 가능.
# INVITE_WEB_ORIGIN=http://localhost:5190
# 같은 IP에서 24시간에 만들 수 있는 공부방 수. 기본 10.
# ROOM_CREATE_PER_IP_PER_DAY=10
# 미디어 저장소(방 배너·로고). 로컬은 disk(파일은 MEDIA_DIR, 기본 server/var/media, 서버가 /media/*로 내준다), 운영은 r2만.
MEDIA_STORAGE=disk
MEDIA_PUBLIC_BASE_URL=http://localhost:5191/media
# MEDIA_DIR=var/media
# MEDIA_STORAGE=r2일 때 필수(운영 비밀 저장소에만).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
