{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyvillage-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "village-api.pocket-time.study", "custom_domain": true }],
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../server/Dockerfile",
      "image_build_context": "../../server",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "ApiContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "WEB_ORIGIN": "https://study.pocket-time.study",
    "MEDIA_PUBLIC_BASE_URL": "https://media.pocket-time.study"
  },
  "observability": { "enabled": true }
}
